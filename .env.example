# Qdrant connection. These defaults target a local Qdrant container.
# For Qdrant Cloud, replace both values with the cluster URL and API key.
QDRANT_URL=http://localhost:6333
QDRANT_KEY=local-dev

# Optional collection for CLI indexing. The Admin UI supplies this per job.
# COLLECTION=my-docs

# Optional stable source root. Set it to the complete collection root when
# indexing subsets so source_file paths remain stable.
# SOURCE_ROOT=C:\absolute\path\to\documents

# Embeddings
# Recommended multilingual mode. Downloads about 2.3 GB on first use and
# caches the BGE-M3 ONNX model under ./models/. Ollama is not required.
# ONNX_EMBED=1

# Explicit provider form (takes precedence over ONNX_EMBED).
# Valid pairs today:
#   bge-m3-onnx + bge-m3-onnx
#   ollama + hashed-tf
# DENSE_PROVIDER=bge-m3-onnx
# SPARSE_PROVIDER=bge-m3-onnx

# Ollama is optional. It is used only by enabled Ollama-backed features:
# Ollama embeddings, legacy per-chunk context, LLM skeleton summaries, tags,
# or local Ask generation. semidex does not start Ollama or pull models.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
CONTEXT_MODEL=gemma3:4b
# TAG_MODEL defaults to CONTEXT_MODEL when unset.
# TAG_MODEL=gemma3:4b

# Skeleton-first Markdown indexing (opt-in). Navigation is enabled for skeleton
# files unless SKELETON_NAV=0 is set. LLM nav summaries are optional.
# SKELETON_CHUNKING=1
# SKELETON_NAV=1
# SKELETON_SUMMARY=llm

# Tags are disabled by default and can be backfilled later.
# TAG_GEN=1
# TAG_PROVIDER=ollama

# Current chunking defaults. Leave these unset unless intentionally tuning and
# benchmarking a collection; settings can also be changed in the Admin UI.
# MAX_CHUNK_TOKENS=512
# MIN_CHUNK_TOKENS=160
# CHUNK_OVERLAP_TOKENS=80
# OVERLAP_SENTENCES=2

# Hybrid retrieval defaults.
# HYBRID_PREFETCH_LIMIT=2
# RRF_K=60
# RERANK_ENABLED=0

# Ask generation. Ollama is the default backend.
# SEMIDEX_GENERATION_BACKEND=ollama
# ASK_MODEL=gemma3:4b
# ASK_NUM_CTX=8192
# GENERATION_DEVICE=auto

# Gemini Ask backend. Integration exists but has not yet completed owner-run
# live acceptance. The key is environment-only: it is never persisted to
# settings.json or returned by the Settings API.
# SEMIDEX_GENERATION_BACKEND=gemini
# ASK_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your-key

# Admin server (localhost-only by default).
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8642
