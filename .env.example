# Local Docker default. For Qdrant Cloud, replace both values with your cluster
# URL and API key.
QDRANT_URL=http://localhost:6333
QDRANT_KEY=local-dev
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
CONTEXT_MODEL=gemma3:4b
TAG_MODEL=gemma3:4b

# Collection to index into (required, passed as env var per run)
# COLLECTION=my-docs

# Chunking
MAX_CHUNK_TOKENS=400
MIN_CHUNK_TOKENS=30
OVERLAP_SENTENCES=2

# LLM parallelism — chunks per LLM call
LLM_BATCH_SIZE=3

# Linking
LINK_TOP=5
LINK_MIN_SCORE=0.75

# Pin the root used to compute source_file paths.
# Set this once so source_file stays stable regardless of which subfolder you index.
# If unset, the path of the target file/folder passed on the CLI is used as root.
# SOURCE_ROOT=/absolute/path/to/your/vault

# Comma-separated allowlist of Qdrant collections to search during linking.
# If unset, all collections are searched (may fail if they have different vector sizes).
# LINK_COLLECTIONS=my-docs,my-notes

# Output directory for Obsidian-compatible chunk review files
CHUNKS_OUT_DIR=./chunks_out

VECTOR_SIZE=1024

# Embedding provider selection.
# ONNX_EMBED=1 is a shorthand for DENSE_PROVIDER=bge-m3-onnx + SPARSE_PROVIDER=bge-m3-onnx.
# Downloads ~2.3 GB model on first run, cached in ./models/. No Ollama needed for embedding.
# ONNX_EMBED=0

# Explicit provider control (takes precedence over ONNX_EMBED).
# Valid combinations: ollama+hashed-tf, bge-m3-onnx+bge-m3-onnx.
# DENSE_PROVIDER=ollama
# SPARSE_PROVIDER=hashed-tf
# DENSE_MODEL=bge-m3

# Hybrid search RRF tuning.
# HYBRID_PREFETCH_LIMIT multiplies the top-N limit for each prefetch leg (default 2).
# RRF_K controls reciprocal rank fusion ranking constant (default 60; higher = smoother).
# HYBRID_PREFETCH_LIMIT=2
# RRF_K=60
