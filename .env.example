QDRANT_URL=https://your-cluster.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_KEY=your-api-key
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
CONTEXT_MODEL=gemma3:4b
TAG_MODEL=gemma3:4b

# Collection to index into (required, passed as env var per run)
# COLLECTION=my-docs

# Chunking
MAX_CHUNK_TOKENS=400
MIN_CHUNK_TOKENS=30
OVERLAP_SENTENCES=2

# LLM parallelism — chunks per LLM call
LLM_BATCH_SIZE=3

# Linking
LINK_TOP=5
LINK_MIN_SCORE=0.75

# Pin the root used to compute source_file paths.
# Set this once so source_file stays stable regardless of which subfolder you index.
# If unset, the path of the target file/folder passed on the CLI is used as root.
# SOURCE_ROOT=/absolute/path/to/your/vault

# Comma-separated allowlist of Qdrant collections to search during linking.
# If unset, all collections are searched (may fail if they have different vector sizes).
# LINK_COLLECTIONS=my-docs,my-notes

# Output directory for Obsidian-compatible chunk review files
CHUNKS_OUT_DIR=./chunks_out

VECTOR_SIZE=1024
