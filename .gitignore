# BEIR external benchmark: downloaded datasets, tokenizer/model cache, and
# generated run artifacts. Only the harness scripts + committed reports are
# tracked — never the dataset itself (BEIR's own license/redistribution
# terms) or generated TREC runs/logs.
benchmarks/external/beir/.cache/
benchmarks/external/beir/.runs/
benchmarks/external/results/.smoke-report.json

# MIRACL external benchmark: downloaded topics/qrels/corpus shards and
# generated run artifacts. Only the harness scripts + committed reports are
# tracked — never the raw dataset content or generated TREC runs/logs.
benchmarks/external/miracl/.cache/
benchmarks/external/miracl/.runs/
benchmarks/external/results/.miracl-smoke-report.json

# Live RRF-k sweep benchmark: generated TREC runs and the smoke-mode
# report. Only the harness scripts + the real committed report are tracked.
benchmarks/external/fusion/.runs/
benchmarks/external/results/.rrf-sweep-smoke-report.json
