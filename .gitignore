# Semidex Lite package staging and npm pack output.
packages/lite/src/
packages/lite/dist/
packages/lite/*.tgz

# BEIR external benchmark: downloaded datasets, tokenizer/model cache, and
# generated run artifacts. Only the harness scripts + committed reports are
# tracked — never the dataset itself (BEIR's own license/redistribution
# terms) or generated TREC runs/logs.
benchmarks/external/beir/.cache/
benchmarks/external/beir/.runs/
benchmarks/external/results/.smoke-report.json

# MIRACL external benchmark: downloaded topics/qrels/corpus shards and
# generated run artifacts. Only the harness scripts + committed reports are
# tracked — never the raw dataset content or generated TREC runs/logs.
benchmarks/external/miracl/.cache/
benchmarks/external/miracl/.runs/
benchmarks/external/results/.miracl-smoke-report.json

# Live RRF-k sweep benchmark: generated TREC runs and the smoke-mode
# report. Only the harness scripts + the real committed report are tracked.
benchmarks/external/fusion/.runs/
benchmarks/external/results/.rrf-sweep-smoke-report.json

# Live weighted-RRF validation benchmark: generated TREC runs and the
# smoke-mode report. Only the harness scripts + the real committed report
# are tracked.
benchmarks/external/fusion/.runs-weighted-rrf-live/
benchmarks/external/results/.weighted-rrf-live-smoke-report.json

# Slavic dense-vs-sparse Belebele benchmark: downloaded dataset JSONL
# files, generated TREC runs, and the smoke-mode report. Only the harness
# scripts + the real committed report are tracked.
benchmarks/external/slavic/.cache/
benchmarks/external/slavic/.runs/
benchmarks/external/results/.slavic-belebele-smoke-report.json

# Slavic weighted-RRF fusion matrix benchmark: generated TREC runs and the
# smoke-mode report. Reuses benchmarks/external/slavic/.cache/ above for
# the downloaded dataset. Only the harness scripts + the real committed
# report are tracked.
benchmarks/external/slavic/.runs-weighted-rrf/
benchmarks/external/results/.slavic-weighted-rrf-smoke-report.json

# Production-path benchmark (Local Semidex vs Semidex Lite, through the
# real indexer/runHybridSearch): materialized fixture files, isolated
# per-run config.json copies, opt-in telemetry JSONL, checkpoints, and
# generated TREC runs. Only the harness scripts + the real committed
# report are tracked.
benchmarks/external/production-path/.cache/
benchmarks/external/production-path/.runs/
benchmarks/external/results/.production-path-*-smoke-report.json
