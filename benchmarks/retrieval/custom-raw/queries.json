{
  "schemaVersion": 5,
  "description": "Custom raw benchmark. Tests semidex on messy inputs, distractors, and mixed-language logs.",
  "queries": [
    {
      "id": "raw-exact-01",
      "type": "exact-token",
      "query": "Error: OOM killed at /src/indexer.js:42",
      "expectedAnchors": [
        { "anchor": "INCIDENT_START", "relevance": 3 },
        { "anchor": "UA_OOM_GRAPH", "relevance": 2 }
      ],
      "expectedTokens": ["OOM killed", "/src/indexer.js:42"],
      "expectedFiles": ["raw-mixed-incident-log.txt"]
    },
    {
      "id": "raw-exact-02",
      "type": "exact-token",
      "query": "WARN: Qdrant timeout after 5000ms",
      "expectedAnchors": [
        { "anchor": "QDRANT_TIMEOUT_LOG", "relevance": 3 }
      ],
      "expectedTokens": ["Qdrant timeout", "5000ms"],
      "expectedFiles": ["raw-mixed-incident-log.txt"]
    },
    {
      "id": "raw-exact-03",
      "type": "exact-token",
      "query": "ONNX_EMBED=1",
      "expectedAnchors": [
        { "anchor": "CFG_ONNX_EMBED", "relevance": 3 }
      ],
      "expectedTokens": ["ONNX_EMBED=1"],
      "expectedFiles": ["raw-config-dump.txt"]
    },
    {
      "id": "raw-exact-04",
      "type": "exact-token",
      "query": "OVERLAP_SENTENCES=2",
      "expectedAnchors": [
        { "anchor": "CFG_OVERLAP_SENTENCES", "relevance": 3 }
      ],
      "expectedTokens": ["OVERLAP_SENTENCES=2"],
      "expectedFiles": ["raw-config-dump.txt"]
    },
    {
      "id": "raw-exact-05",
      "type": "exact-token",
      "query": "LLM_MODEL=gemma3:4b",
      "expectedAnchors": [
        { "anchor": "CFG_LLM_MODEL", "relevance": 3 }
      ],
      "expectedTokens": ["LLM_MODEL=gemma3:4b"],
      "expectedFiles": ["raw-config-dump.txt"]
    },
    {
      "id": "raw-exact-06",
      "type": "exact-token",
      "query": "retrieval_mode hybrid",
      "expectedAnchors": [
        { "anchor": "CFG_HYBRID_MODE", "relevance": 3 }
      ],
      "expectedTokens": ["retrieval_mode", "hybrid"],
      "expectedFiles": ["raw-config-dump.txt"]
    },
    {
      "id": "raw-exact-07",
      "type": "exact-token",
      "query": "sparse_provider bge-m3-onnx",
      "expectedAnchors": [
        { "anchor": "CFG_SPARSE_PROVIDER", "relevance": 3 }
