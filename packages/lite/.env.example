# Semidex Lite — cloud-only configuration. Copy this file to .env (in the
# directory you run `semidex-lite` from) and fill in real values.
#
# Semidex Lite never downloads or initializes a local ONNX or Ollama
# runtime — DENSE_PROVIDER/SPARSE_PROVIDER/SEMIDEX_GENERATION_BACKEND/
# CONTEXT_MODE/TAG_GEN/SKELETON_SUMMARY/COMBINED_LLM/ONNX_EMBED are all
# hard-pinned to their cloud/deterministic values by the CLI itself before
# any of these settings are even read — you cannot re-enable a local
# provider by setting them here.

# Qdrant Cloud connection (required).
QDRANT_URL=https://your-cluster-id.your-region.cloud.qdrant.io
QDRANT_KEY=your-qdrant-cloud-api-key

# Qdrant Cloud Inference dense embedding model for NEW collections. See
# `semidex-lite doctor --probe-inference` for a real inference round-trip
# check, or the README's "Qdrant Cloud embedding models" section for the
# current supported model list.
# QDRANT_CLOUD_DENSE_MODEL=intfloat/multilingual-e5-small

# Qdrant Cloud Inference sparse embedding model for NEW collections.
# Advanced/forward-compatible: when unset, Semidex Lite defaults to
# "qdrant/bm25", currently the only supported sparse model. Setting an
# unsupported model ID causes new-collection profile resolution to fail.
# See the README's "Qdrant Cloud embedding models" section.
# QDRANT_SPARSE_MODEL=qdrant/bm25

# Gemini API key (required for Ask/generation; doctor/serve/index all work
# without it, but Ask requests will fail until it's set).
GEMINI_API_KEY=your-gemini-api-key

# Model used to generate Ask answers. Leave unset to use the built-in
# Gemini default.
# ASK_MODEL=gemini-flash-latest

# Ask v2 (/api/v2/ask, bounded conversational context) settings. Defaults
# shown are safe for most integrations; uncomment only to override.
#
# Number of conversation messages (recentMessages + the current turn) at or
# above which /api/v2/ask attempts a bounded summary refresh.
# ASK_SUMMARY_COMPACTION_THRESHOLD=8
#
# Number of the NEWEST conversation messages compaction leaves untouched
# (raw) when it runs — everything older is what gets folded into the
# refreshed summary. Independent of ASK_HISTORY_MAX_MESSAGES (a separate
# setting bounding a single request's total size, not listed here — see
# the README's Ask v2 section), never derived from it.
# ASK_SUMMARY_RETAINED_MESSAGES=4
#
# Timeout (ms) for the optional bounded summary-compaction generation call.
# On timeout, the response completes normally without an updated summary.
# ASK_SUMMARY_COMPACTION_TIMEOUT_MS=6000

# Collection to index (used by `semidex-lite index <path>`; the CLI has no
# separate --collection flag).
# COLLECTION=my-docs

# Admin server bind address/port (`semidex-lite serve`). Defaults to
# 127.0.0.1:8642 — loopback only, matching full Semidex's own default
# safety posture. Set ADMIN_ALLOW_REMOTE=1 to bind a non-loopback ADMIN_HOST.
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8642
# ADMIN_ALLOW_REMOTE=0

# REQUIRED when ADMIN_ALLOW_REMOTE=1 — comma-separated list of the exact
# Host values (hostname or hostname:port) clients will use to reach this
# server. The server refuses to start without it in remote mode, because
# binding beyond loopback with no Host allow-list leaves the API open to
# DNS-rebinding and Host-header attacks. Not needed for the default
# loopback deployment: 127.0.0.1/localhost/[::1] on the listening port are
# allowed automatically.
#
# NOTE: the API still has NO authentication in this version — a Host
# allow-list is not access control. Do not expose this server directly to
# an untrusted network; put your own authenticated backend in front of it.
# See the README's "Security status" section.
# ADMIN_ALLOWED_HOSTS=semidex.example.com,192.168.1.10:8642

# Exact browser origins allowed to make state-changing requests. Only needed
# behind a TLS-terminating reverse proxy, where the browser sends
# "https://your-domain" but this process sees a plaintext connection and a
# different Host. Comparison is exact: scheme + host + port.
# X-Forwarded-Proto is deliberately NOT trusted (it is attacker-controlled
# on a directly reachable listener), so configure this explicitly instead.
#
# Each entry must be a BARE origin — http:// or https://, host, optional
# port. No username/password, no path, no query string, no fragment: a
# browser's Origin header never contains those, and accepting them would
# silently widen the rule (e.g. "https://user:pass@host/admin" would match
# every path on "https://host"). Invalid entries fail startup rather than
# being quietly normalized.
# ADMIN_ALLOWED_ORIGINS=https://semidex.example.com
# ADMIN_ALLOWED_ORIGINS=https://semidex.example.com,http://192.168.1.10:8642

# Application data directory (config.json, settings.json, tokenizer
# cache). Defaults to a per-OS location outside this package (never writes
# into node_modules/semidex-lite/) — see the README for the exact default
# path on your platform. Only set this if you want a non-default location.
# SEMIDEX_HOME=
