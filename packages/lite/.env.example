# Semidex Lite — cloud-only configuration. Copy this file to .env (in the
# directory you run `semidex-lite` from) and fill in real values.
#
# Semidex Lite never downloads or initializes a local ONNX or Ollama
# runtime — DENSE_PROVIDER/SPARSE_PROVIDER/SEMIDEX_GENERATION_BACKEND/
# CONTEXT_MODE/TAG_GEN/SKELETON_SUMMARY/COMBINED_LLM/ONNX_EMBED are all
# hard-pinned to their cloud/deterministic values by the CLI itself before
# any of these settings are even read — you cannot re-enable a local
# provider by setting them here.

# Qdrant Cloud connection (required).
QDRANT_URL=https://your-cluster-id.your-region.cloud.qdrant.io
QDRANT_KEY=your-qdrant-cloud-api-key

# Qdrant Cloud Inference dense embedding model for NEW collections. See
# `semidex-lite doctor` for a reachability check, or the README for the
# current supported model list.
# QDRANT_CLOUD_DENSE_MODEL=intfloat/multilingual-e5-small

# Gemini API key (required for Ask/generation; doctor/serve/index all work
# without it, but Ask requests will fail until it's set).
GEMINI_API_KEY=your-gemini-api-key

# Model used to generate Ask answers. Leave unset to use the built-in
# Gemini default.
# ASK_MODEL=gemini-flash-latest

# Collection to index (used by `semidex-lite index <path>`; the CLI has no
# separate --collection flag).
# COLLECTION=my-docs

# Admin server bind address/port (`semidex-lite serve`). Defaults to
# 127.0.0.1:8642 — loopback only, matching full Semidex's own default
# safety posture. Set ADMIN_ALLOW_REMOTE=1 to bind a non-loopback ADMIN_HOST.
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8642
# ADMIN_ALLOW_REMOTE=0

# Application data directory (config.json, settings.json, tokenizer
# cache). Defaults to a per-OS location outside this package (never writes
# into node_modules/semidex-lite/) — see the README for the exact default
# path on your platform. Only set this if you want a non-default location.
# SEMIDEX_HOME=
